NEXT_PUBLIC_WHATSAPP=234XXXXXXXXXX
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server-only secrets. NEVER put NEXT_PUBLIC_ in front of these two. ----
# The service role key lets the admin panel create students. Copy it from Project Settings > API ("service_role").
SUPABASE_SERVICE_ROLE_KEY=
# Any long random text (30+ characters). It protects Access PINs. Do NOT change it after students have PINs.
ACCESS_PIN_SECRET=

# ---- Optional ----
# Only if Supabase says the hidden PIN email is invalid: a real domain you own, for example yourdomain.com
PIN_EMAIL_DOMAIN=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_SITE_URL=

# ---- WhatsApp renewal reminders (optional) ----
# Without these, the admin panel still shows who needs a reminder and gives an "Open WhatsApp" button for each student.
# Twilio WhatsApp sender (Twilio Console > Messaging > Senders). Use a number like +14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Approved WhatsApp message template (starts with HX). Needed to message students first, outside the 24 hour window.
# Template text: Hello {{1}}, this is MAF Tech Academy. Your access {{2}}. Please reply to this message or contact us to renew your Access PIN.
TWILIO_CONTENT_SID=
# Used to read numbers like 0801 234 5678 (default 234 for Nigeria)
DEFAULT_COUNTRY_CODE=234
# Any long random text. The daily job (/api/cron/renewal-reminders) must send it as  Authorization: Bearer <this value>
CRON_SECRET=
